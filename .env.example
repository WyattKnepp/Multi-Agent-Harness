# Copy to .env and fill in. .env is gitignored: never commit it.
# This one file configures everything. On the laptop, the dispatcher reads it
# directly, and deploy.sh reads it and copies the server's settings to the
# droplet. Quote any value that contains spaces.

# --- Droplet (used by deploy.sh) ---
DROPLET=root@your.droplet.ip         # ssh target
DROPLET_KEY=~/.ssh/your-key          # ssh private key for that host
APP_USER=www                         # droplet user the app runs as; needs pm2 and a logged-in `claude`
APP_DIR=/home/www/idea-pipeline      # where the app lives on the droplet
PM2_NAME=idea-pipeline               # pm2 process name

# --- Server ---
APP_DOMAIN=ideas.example.com         # public hostname; the dispatcher connects to https://APP_DOMAIN
PORT=3006                            # port the server binds on 127.0.0.1; point your reverse proxy at it
AGENT_TOKEN=                         # shared secret between laptop and server: openssl rand -hex 32
GRILL_MODEL=                         # optional model for grilling, e.g. opus (blank = claude's default)

# --- Laptop (dispatcher) ---
PROJECTS_DIR=~/Programs              # folder holding your projects; new projects are created here
POLL_SECONDS=15                      # how often to check for sent ideas
CLAUDE_ARGS=                         # extra flags for each launched claude, e.g. "--permission-mode plan"
REMOTE_CONTROL=1                     # start each agent with Remote Control so you can steer it from your phone (0 = off)
HERDR_SESSION=                       # named herdr session to launch into (blank = default)

# --- Project hosting (make new / deploy / caddy / status / ...; see CLAUDE.md) ---
# Reuses DROPLET, DROPLET_KEY and APP_USER above: project clones belong to
# APP_USER and run under its pm2. DROPLET needs root (or sudo) for Caddy.
DROPLET_PROJECTS_DIR=/home/www       # droplet folder holding one clone per project
BASE_DOMAIN=example.com              # each project is served at <subdomain>.BASE_DOMAIN
CADDYFILE=/etc/caddy/Caddyfile       # main Caddyfile; gets one `import CADDY_SITES_DIR/*.caddy` line
CADDY_SITES_DIR=/etc/caddy/sites.d   # one <project>.caddy site file per project
CADDY_SITE_IMPORTS="require_login"   # Caddyfile snippets every project site imports, e.g. "my_tls require_login"
CADDY_RELOAD="systemctl reload caddy"
PORT_RANGE_START=3100                # ports for new apps are picked from this range
PORT_RANGE_END=3199
GITHUB_OWNER=                        # account/org for new repos (blank = the user `gh` is logged in as)
