# Droplet runner settings: ~/.config/droplet-runner/runner.env, mode 600.
# start.sh refuses any other mode. Tokens are filled in on the droplet by
# copying them between files there; they never pass through chat or argv.

# The ideas app's internal API (server/internal.js) and its INTERNAL_TOKEN.
PIPELINE_URL=http://127.0.0.1:3007
PIPELINE_TOKEN=

# Claude Code, logged in with your subscription: the token `claude setup-token` prints.
CLAUDE_BIN=/home/openclaw/.local/bin/claude
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MINUTES=45

# Lawn's agent listener (loopback) and token file, for posting into chat threads.
RUNNER_LAWN_URL=http://127.0.0.1:3101
RUNNER_LAWN_TOKEN_FILE=/home/openclaw/.config/lawn/agent-token

# Where things live.
PROJECTS_FILE=/home/openclaw/droplet-runner/projects.deploy.json
RUNNER_WORK_DIR=/home/openclaw/droplet-runner/work
SHARED_TARGET_DIR=/home/openclaw/droplet-runner/cache/cargo-target

# Previews: one gateway port behind Caddy, previews on the range.
PREVIEW_GATEWAY=127.0.0.1:3190
PREVIEW_PORTS=3191-3199
PREVIEW_BASE_URL=https://preview.example.com

# Builds: 2 jobs fits 2 vCPU / 3.8 GB with the swap file (see CHAT_BUILDER.md).
CARGO_BUILD_JOBS=2
STEP_TIMEOUT_MINUTES=40
POLL_SECONDS=5
RUNNER_GIT_NAME="Droplet runner"
RUNNER_GIT_EMAIL=droplet-runner@localhost
